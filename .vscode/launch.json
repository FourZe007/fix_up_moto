{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fix_up_moto",
      "request": "launch",
      "type": "dart",
      // Hands the build-time secrets (the WhatsApp gateway's API key) to the
      // app. The file is not in git: copy dart_defines.example.json to it.
      "toolArgs": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      // Debug only. An account that already has bikes looks like a new member
      // (the bikes it had at launch are hidden from the bike count), and the app
      // tour and first-booking memory are cleared at every launch, so the
      // first-run guidance shows each time. A release build ignores it.
      "name": "fix_up_moto (new member)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define-from-file=dart_defines.json",
        "--dart-define=SIMULATE_NEW_MEMBER=true"
      ]
    }
  ]
}
