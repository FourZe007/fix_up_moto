{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fix_up_moto",
      "request": "launch",
      "type": "dart",
      // Hands the build-time secrets (the WhatsApp gateway's API key) to the
      // app. The file is not in git: copy dart_defines.example.json to it.
      "toolArgs": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      // Debug only. An account that already has bikes looks like a new member
      // (the bikes it had at launch are hidden from the bike count), and the app
      // tour, Add Bike's field guide and first-booking memory are cleared at
      // every launch, so the first-run guidance shows each time (the tour, then
      // the guide to each text field on Add Bike). A release build ignores it.
      "name": "fix_up_moto (new member)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define-from-file=dart_defines.json",
        "--dart-define=SIMULATE_NEW_MEMBER=true"
      ]
    },
    {
      // Debug only. The other half: an account that already has its bikes (they
      // stay real) looks like a member who has not booked yet. The app tour
      // plays at every launch and its last step offers "Buat booking sekarang",
      // Home offers "Buat booking pertama Anda", and booking through either ends
      // in the "Lihat" pointer to the Booking tab. A booking made in the app
      // clears the card until the next launch. A release build ignores it.
      "name": "fix_up_moto (first booking)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define-from-file=dart_defines.json",
        "--dart-define=SIMULATE_FIRST_BOOKING=true"
      ]
    }
  ]
}
